{
  "name": "apmac-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:turbo": "next dev --turbopack -H 127.0.0.1",
    "dev:clean": "npm run kill:dev && npm run clean && next dev -H 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test:ui": "playwright test",
    "clean": "rm -rf .next node_modules/.cache",
    "clean:all": "rm -rf .next node_modules/.cache .turbo",
    "dev:fresh": "npm run clean && next dev -H 127.0.0.1",
    "kill:dev": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.0",
    "@google/generative-ai": "^0.21.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.21.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/d3": "^7.4.3",
    "animejs": "^3.2.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "framer-motion": "^12.23.24",
    "html-react-parser": "^5.2.14",
    "lucide-react": "^0.553.0",
    "marked": "^17.0.1",
    "motion": "^12.23.24",
    "next": "^16.1.2",
    "next-auth": "^4.24.8",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "sanitize-html": "^2.17.0",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4",
    "@types/animejs": "^3.1.13",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "20.19.25",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "@types/xlsx": "^0.0.35",
    "prisma": "^5.21.1",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
