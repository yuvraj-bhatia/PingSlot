datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Enums ----------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  USER
  CHATBOT
  SYSTEM
}

enum ChatMessageSender {
  USER
  BOT
  SYSTEM
}

enum SubscriptionPlanType {
  FREE
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// ---------- Core models (your originals, extended) ----------

model organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  userCount Int      @default(0)

  // Help / support / subscriptions
  tickets       Ticket[]
  helpArticles  HelpArticle[]
  forumThreads  ForumThread[]
  uiHelpAnchors UiHelpAnchor[]
  chatSessions  ChatSession[]
  subscriptions Subscription[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String
  lastName      String
  companyName   String
  passwordHash  String
  name          String?
  phone         String?
  isAdmin       Boolean   @default(false)
  emailVerified DateTime?
  image         String?

  // Profile fields
  role       String?
  department String?

  // Onboarding preferences
  watchTutorial    Boolean  @default(true)
  selectedFeatures String[] @default([])

  accounts Account[]
  sessions Session[]

  // Support / tickets
  createdTickets  Ticket[]        @relation("TicketCreatedBy")
  assignedTickets Ticket[]        @relation("TicketAssignedTo")
  ticketComments  TicketComment[] @relation("UserTicketComments")

  // Help center / forum
  forumThreads ForumThread[] @relation("UserForumThreads")
  forumReplies ForumReply[]  @relation("UserForumReplies")
  helpArticles HelpArticle[] @relation("HelpArticlesAuthor")

  // AI chatbot
  chatSessions ChatSession[] @relation("UserChatSessions")
  chatMessages ChatMessage[] @relation("UserChatMessages")

  // ML Predictions
  mlPredictions MLPrediction[] @relation("UserMLPredictions")

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?
  organization   organization? @relation(fields: [organizationId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Ticketing / Support ----------

model Ticket {
  id          String @id @default(cuid())
  // matches your React "subject"
  subject     String
  // matches your React "description"
  description String @db.Text

  // maps to "low" | "medium" | "high" | "urgent" (you'll map to enum in API)
  priority TicketPriority @default(MEDIUM)

  // maps to "Open" | "In Progress" | "Resolved" | "Closed"
  status TicketStatus @default(OPEN)

  category String?
  tags     String[]     @default([])
  source   TicketSource @default(USER)

  createdById String
  createdBy   User   @relation("TicketCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  organizationId String?
  organization   organization? @relation(fields: [organizationId], references: [id])

  comments TicketComment[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ChatSession ChatSession[]
}

model TicketComment {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  authorId String
  author   User   @relation("UserTicketComments", fields: [authorId], references: [id])

  body       String  @db.Text
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())
}

// ---------- Help Articles / Knowledge Base ----------

model HelpArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?
  contentHtml String   @db.Text
  category    String?
  tags        String[] @default([])
  keywords    String[] @default([])
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)

  organizationId String?
  organization   organization? @relation(fields: [organizationId], references: [id])

  authorId String?
  author   User?   @relation("HelpArticlesAuthor", fields: [authorId], references: [id])

  anchors UiHelpAnchor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Anchors for “drag & drop ?” → article
model UiHelpAnchor {
  id          String  @id @default(cuid())
  pageKey     String // e.g. "/dashboard"
  selector    String? // CSS selector / data-attr
  description String?

  articleId String?
  article   HelpArticle? @relation(fields: [articleId], references: [id])

  organizationId String?
  organization   organization? @relation(fields: [organizationId], references: [id])

  posX Float?
  posY Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Help Forum ----------

model ForumThread {
  id          String   @id @default(cuid())
  subject     String
  contentHtml String   @db.Text // first post as HTML
  keywords    String[] @default([])
  isPinned    Boolean  @default(false)
  isLocked    Boolean  @default(false)

  authorId String
  author   User   @relation("UserForumThreads", fields: [authorId], references: [id])

  organizationId String?
  organization   organization? @relation(fields: [organizationId], references: [id])

  replies ForumReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForumReply {
  id          String @id @default(cuid())
  contentHtml String @db.Text

  threadId String
  thread   ForumThread @relation(fields: [threadId], references: [id])

  authorId String
  author   User   @relation("UserForumReplies", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- AI Chatbot ----------

model ChatSession {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("UserChatSessions", fields: [userId], references: [id])

  organizationId String?
  organization   organization? @relation(fields: [organizationId], references: [id])

  pageKey    String?
  isResolved Boolean @default(false)

  // ticket created from this chat (if any)
  createdTicketId String?
  createdTicket   Ticket? @relation(fields: [createdTicketId], references: [id])

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id])

  sender  ChatMessageSender
  content String            @db.Text

  userId String?
  user   User?   @relation("UserChatMessages", fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ---------- Subscriptions ----------

model Subscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   organization @relation(fields: [organizationId], references: [id])

  plan   SubscriptionPlanType @default(FREE)
  status SubscriptionStatus   @default(TRIALING)

  trialEndsAt        DateTime?
  currentPeriodStart DateTime? @default(now())
  currentPeriodEnd   DateTime?

  externalCustomerId String?
  externalSubId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- ML Predictions ----------

model MLPrediction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserMLPredictions", fields: [userId], references: [id], onDelete: Cascade)

  // Type of prediction: "automl" or "linear_exhaustive"
  predictionType String

  // Input data
  inputX Json // Store the X feature matrix
  inputY Json // Store the Y target variable

  featureNames String[] @default([])

  // Prediction parameters
  normalizationMethod   String?
  featureSelectionMethod String? // Only for automl
  testSize              Float?
  cvFolds               Int?
  includeRidge          Boolean? // Only for linear_exhaustive
  includeLasso          Boolean? // Only for linear_exhaustive
  maxFeatures           Int? // Only for linear_exhaustive

  // Results (stored as JSON for flexibility)
  results Json // Complete response from the API

  // Key metrics (for easy querying)
  bestModel      String
  bestModelScore Float

  // Timestamp
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, predictionType])
}
