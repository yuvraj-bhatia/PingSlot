# ============================================================================
# PingSlot Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# ============================================================================
# Database (Required)
# ============================================================================
# SQLite for development, PostgreSQL for production
DATABASE_URL="file:./dev.db"
# For production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/pingslot?sslmode=require"

# ============================================================================
# External APIs (Required)
# ============================================================================

# Firecrawl - Web scraping service (Required)
# Get your API key at https://firecrawl.dev
FIRECRAWL_API_KEY="your-firecrawl-api-key"

# Groq - LLM for availability detection (Recommended)
# Get your API key at https://console.groq.com
GROQ_API_KEY="your-groq-api-key"
# Model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL="llama-3.3-70b-versatile"

# Resend - Email notifications (Recommended)
# Get your API key at https://resend.com
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="PingSlot Alerts <alerts@yourdomain.com>"

# Reducto - PDF parsing for requirements (Optional)
# Get your API key at https://reducto.ai
REDUCTO_API_KEY=""

# ============================================================================
# App Configuration
# ============================================================================

# Public URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cache TTL for availability checks (in minutes)
CACHE_TTL_MINUTES=5

# Default check interval for cron (in minutes)
CHECK_INTERVAL_MINUTES=15

# ============================================================================
# Security (Production)
# ============================================================================

# Secret for securing cron endpoints (generate a random string)
CRON_SECRET=""

# ============================================================================
# Development
# ============================================================================

# Set to "development" for dev mode features
NODE_ENV="development"
