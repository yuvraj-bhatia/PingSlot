# ============================================================================
# PingSlot Backend Configuration
# ============================================================================

# Database
DATABASE_URL="file:./dev.db"

# Firecrawl - Web scraping service
# Get your API key at https://firecrawl.dev
FIRECRAWL_API_KEY="your-firecrawl-api-key"

# Resend - Email service
# Get your API key at https://resend.com
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="PingSlot Alerts <alerts@yourdomain.com>"

# Optional: Reducto for PDF parsing
# Get your API key at https://reducto.ai
REDUCTO_API_KEY=""

# Check interval in minutes (for cron scheduling)
CHECK_INTERVAL_MINUTES=15
