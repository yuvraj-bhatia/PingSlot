# ===========================================
# APMAC-UI Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# For Vercel deployment, add these in the Vercel dashboard under Settings > Environment Variables

# ===========================================
# DATABASE (Required)
# ===========================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/apmac?schema=public"

# ===========================================
# NEXTAUTH (Required)
# ===========================================
# The URL where your app is hosted (no trailing slash)
# For local dev: http://localhost:3000
# For Vercel: Your Vercel deployment URL (e.g., https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Secret for signing JWTs - generate with: openssl rand -base64 32
# IMPORTANT: Use a different secret for each environment
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"

# ===========================================
# GOOGLE OAUTH (Optional - for Google sign-in)
# ===========================================
# Get these from Google Cloud Console: https://console.cloud.google.com
# Add authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# ML/PYTHON BACKEND API (Required)
# ===========================================
# URL where your partner's Python backend is deployed
# For local dev: http://localhost:8000
# For production: The URL where the Python API is deployed

# Client-side (accessible in browser - prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_ML_API_BASE="http://localhost:8000"

# Server-side (for API routes - not exposed to browser)
ML_API_BASE_URL="http://localhost:8000"

# Optional API key for ML backend
APTECH_API_KEY=""

# ===========================================
# AI CHATBOT (Optional)
# ===========================================
GEMINI_API_KEY=""

# ===========================================
# DEMO MODE (Optional)
# ===========================================
# Enable mock messaging on /demo
DEMO_MODE="0"

# ===========================================
# VERCEL DEPLOYMENT NOTES
# ===========================================
# 1. Add all required environment variables in Vercel Dashboard
# 2. For NEXTAUTH_URL on Vercel, use your deployment URL
# 3. Update Google OAuth redirect URIs to include your Vercel URL
# 4. Ensure your Python backend CORS allows your Vercel domain
# 5. DATABASE_URL should point to a production PostgreSQL instance (e.g., Neon, Supabase, PlanetScale)
